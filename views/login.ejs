<%- include('layout', { body: `
  <div style="max-width: 400px; margin: 50px auto; background: white; padding: 30px; border-radius: 8px;">
    <h2>התחברות למערכת הניהול</h2>
    ${error ? `<p style="color: red;">${error}</p>` : ''}
    <form action="/login" method="POST">
      <input type="text" name="username" placeholder="שם משתמש" required style="width: 100%; margin-bottom: 10px; padding: 10px;"><br>
      <input type="password" name="password" placeholder="סיסמה" required style="width: 100%; margin-bottom: 10px; padding: 10px;"><br>
      <button type="submit" style="width: 100%; padding: 10px; background: #0066cc; color: white; border: none; cursor: pointer;">התחבר</button>
    </form>
  </div>
` }) %>